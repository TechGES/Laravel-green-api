{
    "name": "ges/laravel-green-api",
    "version": "1.0.0",
    "description": "Core Green API integration for Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload-dev": {
        "psr-4": {
            "Ges\\LaravelGreenApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "autoload": {
        "psr-4": {
            "Ges\\LaravelGreenApi\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ges\\LaravelGreenApi\\GreenApiServiceProvider"
            ]
        }
    }
}
